:root {
}

#ItemSlot {
    width: 56px;
    height: 56px;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    background-image: url("project://database/Assets/Brackeys/2D%20Mega%20Pack/Backgrounds/BlueBackground.png?fileID=21300000&guid=10ebe7a8e14363545946d5a92ac0bcb0&type=3#BlueBackground");
    align-items: center;
    justify-content: center;
    -unity-slice-scale: 0.15px;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out;
    max-width: 56px;
    max-height: 56px;
}

#ItemSlot:hover {
    scale: 1.05 1.05 1.05;
}

#Icon {
    width: 100%;
    height: 100%;
    background-image: none;
}
