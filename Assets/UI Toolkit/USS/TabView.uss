:root {
    font-size: 45px;
}

.unity-tab-view {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.unity-tab-view__header-container {
    height: 60px;
}

.unity-tab-view__content-container {
    flex-grow: 1;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-basis: 80%;
    align-items: center;
}

.unity-tab {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.unity-tab__content-container {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    align-items: center;
}

.template-settings {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
}
